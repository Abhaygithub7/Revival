# Revival Backend Configuration
# Copy this to .env and fill in your values.

# MongoDB Atlas connection string (get from https://cloud.mongodb.com)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/revival?retryWrites=true&w=majority

# JWT secret — change this to a random string in production
JWT_SECRET=revival_secret_key_change_in_production_2024
JWT_EXPIRES_IN=7d

# Server port
PORT=3000
